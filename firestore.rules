rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isConsultationMember() { return signedIn() && request.auth.uid in resource.data.participantIds; }

    match /users/{uid} { allow read: if owns(uid) || isAdmin(); allow create: if owns(uid) && request.resource.data.accountType in ['student', 'advisor']; allow update: if isAdmin() || (owns(uid) && request.resource.data.accountType == resource.data.accountType && request.resource.data.isActive == resource.data.isActive); allow delete: if isAdmin(); }
    match /students/{uid} { allow read, create, update: if owns(uid) || isAdmin(); allow delete: if isAdmin(); }
    match /advisors/{uid} { allow read: if signedIn(); allow create, update: if owns(uid) || isAdmin(); allow delete: if isAdmin(); }
    match /majors/{majorId} { allow read: if signedIn() && (resource.data.isPublished == true || isAdmin()); allow create, update, delete: if isAdmin(); }
    match /assessments/{assessmentId} { allow read: if signedIn() && (resource.data.isPublished == true || isAdmin()); allow create, update, delete: if isAdmin(); }
    match /assessment_results/{resultId} { allow read: if owns(resource.data.studentId) || isAdmin(); allow create: if owns(request.resource.data.studentId); allow update, delete: if isAdmin(); }
    match /appointments/{appointmentId} { allow read: if owns(resource.data.studentId) || owns(resource.data.advisorId) || isAdmin(); allow create: if signedIn() && request.auth.uid == request.resource.data.studentId; allow update: if owns(resource.data.studentId) || owns(resource.data.advisorId) || isAdmin(); }
    match /appointment_slots/{slotId} { allow read: if signedIn(); allow create: if signedIn() && request.auth.uid == request.resource.data.studentId; }
    match /recommendations/{recommendationId} { allow read: if owns(resource.data.studentId) || isAdmin(); allow create, update: if owns(request.resource.data.studentId) || isAdmin(); }
    match /consultations/{consultationId} { allow read: if isConsultationMember() || isAdmin(); allow create: if signedIn() && request.auth.uid == request.resource.data.studentId; allow update: if isConsultationMember() || isAdmin(); allow delete: if isAdmin(); }
    match /conversations/{conversationId} { allow read: if isConsultationMember() || isAdmin(); allow update: if isConsultationMember() || isAdmin(); allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds; }
    match /conversations/{conversationId}/messages/{messageId} { allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds; allow create: if signedIn() && request.auth.uid == request.resource.data.senderId; allow update, delete: if signedIn() && request.auth.uid == resource.data.senderId; }
  }
}
